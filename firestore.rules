rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }
    function email() { return request.auth.token.email.lower(); }
    function isAdmin() {
      return signedIn() && email() == 'rodri.rita24@gmail.com';
    }
    function isReader() {
      return signedIn()
        && exists(/databases/$(database)/documents/config/access)
        && email() in get(/databases/$(database)/documents/config/access).data.get('readers', []);
    }
    function canRead() { return isAdmin() || isReader(); }

    match /devices/{deviceId} {
      allow read: if canRead();
      allow write: if isAdmin();
      match /history/{entryId} {
        allow read: if canRead();
        allow write: if isAdmin();
      }
    }
    match /photos/{photoId} {
      allow read: if canRead();
      allow write: if isAdmin();
    }
    match /config/access {
      allow read, write: if isAdmin();
    }
  }
}
